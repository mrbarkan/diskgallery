# macOS
.DS_Store

# The .xcodeproj is generated by XcodeGen from project.yml, but is committed
# so the project builds with stock `xcodebuild` (no XcodeGen required by users).
# Ignore only the per-user scheme/state inside it:
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

